# Backend Production Environment Variables

# Core Django Settings
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=generate-a-secure-random-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tnelectiondb
DATABASE_NAME=tnelectiondb
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS and CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-frontend.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-production-frontend.com
